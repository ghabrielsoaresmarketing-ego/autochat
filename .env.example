# Senha para entrar no painel
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Painel da Meta > seu app > Instagram > Configuração da API com login do Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Banco Postgres (Neon). Na Vercel é criada automaticamente pela integração.
# Sem isso, localmente o app usa um banco de arquivo em .data/ (PGlite).
DATABASE_URL=

# Opcional: e-mail mostrado nas páginas de privacidade e exclusão de dados
CONTACT_EMAIL=
